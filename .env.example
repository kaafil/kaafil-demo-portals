# Copy this file to .env and fill in both values.
#
#   cp .env.example .env
#
# .env is gitignored, and it is the one file that never travels with a client
# branch.

# ── KAAFIL_API_KEY — SERVER ONLY ───────────────────────────────────────────
#
# Read by config/env.ts, which carries `import 'server-only'`, so a client
# component that reaches for it fails the build rather than shipping it.
#
# Do NOT rename this to NEXT_PUBLIC_ANYTHING. Next inlines every
# NEXT_PUBLIC_-prefixed variable into the browser bundle, and a partner API key
# in a browser bundle is a compromised tenant: that key can mint a session for
# any manager in the tenant, read every trip, and erase a traveller.
#
# The browser only ever holds a short-lived session token that a route handler
# minted for one identity.
#
# A kf_test_ key runs against the sandbox and is capped at 5 trips / 50
# travellers per trip — fine for wiring things up, far too thin to demo. This
# repo seeds 56 departures and 728 travellers, so a demo tenant wants a
# kf_live_ key. There is no undo on the live plane; use a tenant that holds
# nothing real.
KAAFIL_API_KEY=kf_test_replace_me

# Your own id for the agency these departures belong to. You choose the string;
# Kaafil stores it as the agency's external reference and you address the
# agency by it forever after. The fixture's own agency code is the sensible
# default.
KAAFIL_AGENCY_REF=sharma-travels

# Engine host override. Undocumented on purpose — you want this only if you are
# running the engine locally. Leave it unset and the SDK resolves the host from
# the key's plane.
# KAAFIL_BASE_URL=http://localhost:8080
